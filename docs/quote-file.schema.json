{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revu-quote-builder/quote-file.schema.json",
  "title": "Revu Quote Builder saved quote file",
  "description": "A quote saved by Revu Quote Builder (Save quote). Read 'summary' for the calculated results; 'quote' holds the inputs the app re-opens. See docs/json-format.md. Unknown fields may appear in later versions and should be ignored.",
  "type": "object",
  "required": ["kind", "version", "quote"],
  "properties": {
    "kind": { "const": "revu-quote-builder/quote" },
    "version": { "type": "integer", "minimum": 1, "description": "1 = no summary; 2 = adds summary." },
    "savedAt": { "type": "string", "format": "date-time" },
    "summary": { "$ref": "#/$defs/summary" },
    "quote": { "$ref": "#/$defs/quote" }
  },
  "if": { "properties": { "version": { "minimum": 2 } } },
  "then": { "required": ["summary"] },

  "$defs": {
    "money": { "type": "number", "description": "US dollars, rounded to cents." },
    "numberOrText": {
      "description": "A value as typed in the app: a number, or text such as \"2,200\" / \"$2.85\". Empty = automatic.",
      "type": ["number", "string", "null"]
    },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unit": { "enum": ["sf", "lf", "ea"] },

    "summary": {
      "type": "object",
      "required": ["currency", "quoteNumber", "lines", "totals", "alternates"],
      "properties": {
        "note": { "type": "string" },
        "currency": { "const": "USD" },
        "quoteNumber": { "type": "string" },
        "date": { "$ref": "#/$defs/isoDate" },
        "generalContractor": {
          "type": "object",
          "properties": { "name": { "type": "string" }, "attention": { "type": "string" } }
        },
        "project": {
          "type": "object",
          "properties": { "name": { "type": "string" }, "address": { "type": "string" } }
        },
        "constructionType": { "enum": ["new", "remodel", null] },
        "laborRate": {
          "type": "object",
          "properties": {
            "area": { "enum": ["local", "bayArea"] },
            "areaSource": { "enum": ["projectCity", "pickedOnQuote"] },
            "city": { "type": ["string", "null"] },
            "hourlyRate": { "type": ["number", "null"] },
            "hoursPerDay": { "type": ["number", "null"] },
            "perDiemVehiclePerDay": { "type": ["number", "null"] },
            "dayRate": { "type": ["number", "null"] }
          }
        },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/summaryLine" } },
        "totals": {
          "type": "object",
          "required": ["material", "labor", "baseBid"],
          "properties": {
            "material": { "$ref": "#/$defs/money" },
            "labor": { "$ref": "#/$defs/money" },
            "laborDays": { "type": "number" },
            "subtotal": { "$ref": "#/$defs/money" },
            "salesTaxPct": { "type": "number" },
            "salesTax": { "$ref": "#/$defs/money" },
            "baseBid": { "$ref": "#/$defs/money", "description": "The quote total. Alternates are not included." }
          }
        },
        "alternates": { "type": "array", "items": { "$ref": "#/$defs/summaryAlternate" } },
        "scopeOfWork": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "addendaReviewed": { "type": ["string", "null"] },
        "incomplete": {
          "type": "object",
          "properties": {
            "linesMissingRates": { "type": "integer" },
            "linesMissingCount": { "type": "integer" },
            "alternatesIncomplete": { "type": "integer" }
          }
        }
      }
    },

    "summaryLine": {
      "type": "object",
      "required": ["key", "scopeOfWork", "description", "unit", "qty", "material", "labor", "total"],
      "properties": {
        "key": { "type": "string" },
        "scopeOfWork": { "type": "string" },
        "description": { "type": "string" },
        "code": { "type": ["string", "null"] },
        "catalogItem": { "type": "string" },
        "bluebeamSubject": { "type": ["string", "null"] },
        "manual": { "type": "boolean" },
        "unit": { "$ref": "#/$defs/unit" },
        "takeoffQty": { "type": ["number", "null"] },
        "qty": { "type": "number" },
        "qtyEnteredBelowTakeoff": { "type": "boolean" },
        "heightFt": { "type": ["number", "null"] },
        "linealFt": { "type": ["number", "null"] },
        "count": { "type": ["integer", "null"] },
        "countType": { "type": "string" },
        "materialRate": { "type": ["number", "null"] },
        "unitsPerDay": { "type": ["number", "null"] },
        "laborDays": { "type": "number" },
        "material": { "$ref": "#/$defs/money" },
        "labor": { "$ref": "#/$defs/money" },
        "total": { "$ref": "#/$defs/money" },
        "markupColor": { "type": ["string", "null"] },
        "bluebeamRowIds": { "type": "array", "items": { "type": "string" } }
      }
    },

    "summaryAlternate": {
      "type": "object",
      "required": ["number", "name", "direction", "kind", "amount", "signedAmount"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "pattern": "^(ADD|DEDUCT) ALTERNATE #\\d+$" },
        "direction": { "enum": ["add", "deduct"] },
        "kind": { "enum": ["line", "swap", "lump"] },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "appliesToLine": { "type": ["string", "null"] },
        "unit": { "anyOf": [{ "$ref": "#/$defs/unit" }, { "type": "null" }] },
        "qty": { "type": ["number", "null"] },
        "material": { "$ref": "#/$defs/money" },
        "labor": { "$ref": "#/$defs/money" },
        "salesTax": { "$ref": "#/$defs/money" },
        "amount": { "$ref": "#/$defs/money", "minimum": 0 },
        "signedAmount": { "$ref": "#/$defs/money" },
        "incomplete": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },

    "quote": {
      "type": "object",
      "required": ["number", "date", "rates"],
      "properties": {
        "number": { "type": "string" },
        "numberCommitted": { "type": "boolean" },
        "date": { "$ref": "#/$defs/isoDate" },
        "gc": { "type": "object", "properties": { "name": { "type": "string" }, "attention": { "type": "string" } } },
        "project": { "type": "object", "properties": { "name": { "type": "string" }, "address": { "type": "string" } } },
        "constructionType": { "enum": ["new", "remodel", ""] },
        "notes": { "type": "string" },
        "scopeText": { "type": "string" },
        "validDays": { "$ref": "#/$defs/numberOrText" },
        "taxPct": { "$ref": "#/$defs/numberOrText" },
        "proposal": {
          "type": "object",
          "properties": { "showSplit": { "type": "boolean" }, "lumpSum": { "type": "boolean" }, "showUnitQty": { "type": "boolean" } }
        },
        "internal": { "type": "object", "properties": { "showCalc": { "type": "boolean" } } },
        "groupByRoom": { "type": "boolean" },
        "laborZone": { "enum": ["auto", "local", "bay"] },
        "source": { "anyOf": [{ "$ref": "#/$defs/source" }, { "type": "null" }] },
        "excludedRows": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "manualLines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "catalogSubject"],
            "properties": {
              "id": { "type": "string" },
              "catalogSubject": { "type": "string" },
              "qty": { "$ref": "#/$defs/numberOrText" },
              "height": { "type": "string" }
            }
          }
        },
        "lineOverrides": { "type": "object", "additionalProperties": { "$ref": "#/$defs/lineOverride" } },
        "alternates": { "type": "array", "items": { "$ref": "#/$defs/alternateInput" } },
        "addenda": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "number": { "type": "string" },
              "date": { "anyOf": [{ "$ref": "#/$defs/isoDate" }, { "const": "" }] }
            }
          }
        },
        "addendaNone": { "type": "boolean" },
        "rates": { "$ref": "#/$defs/rates" }
      }
    },

    "source": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "fileName": { "type": "string" },
        "importedAt": { "type": "string" },
        "headers": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/takeoffRow" } },
        "subtotals": { "type": "array", "items": { "$ref": "#/$defs/takeoffRow" } },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "level": { "type": "string" }, "code": { "type": "string" }, "message": { "type": "string" } }
          }
        },
        "autoFilled": { "type": "string" }
      }
    },

    "takeoffRow": {
      "type": "object",
      "required": ["id", "subject", "baseSubject"],
      "properties": {
        "id": { "type": "string" },
        "line": { "type": "integer" },
        "subject": { "type": "string" },
        "baseSubject": { "type": "string" },
        "label": { "type": "string" },
        "room": { "type": "string" },
        "space": { "type": "string" },
        "layer": { "type": "string" },
        "color": { "type": "string" },
        "comments": { "type": "string" },
        "page": { "type": "string" },
        "measurement": { "type": ["number", "null"] },
        "measurementUnit": { "type": "string" },
        "sqFt": { "type": ["number", "null"] },
        "matHeight": { "type": ["number", "null"] },
        "installHeight": { "type": ["number", "null"] },
        "installHeightText": { "type": "string" },
        "wasteSqFt": { "type": ["number", "null"] },
        "rowUnit": { "enum": ["ea", "lf", null] },
        "count": { "type": "integer" },
        "isSubtotal": { "type": "boolean" },
        "detailCount": { "type": "integer" }
      }
    },

    "lineOverride": {
      "type": "object",
      "properties": {
        "qty": { "$ref": "#/$defs/numberOrText" },
        "height": { "type": "string" },
        "materialRate": { "$ref": "#/$defs/numberOrText" },
        "unitsPerDay": { "$ref": "#/$defs/numberOrText" },
        "laborDays": { "$ref": "#/$defs/numberOrText" },
        "rooms": { "$ref": "#/$defs/numberOrText" },
        "roomNoun": { "type": "string" },
        "scopeNote": { "type": "string" },
        "scopeLabel": { "type": "string" },
        "description": { "type": "string" },
        "scope": { "type": "string" },
        "excluded": { "type": ["boolean", "string"] }
      }
    },

    "alternateInput": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["line", "swap", "lump"] },
        "title": { "type": "string" },
        "catalogSubject": { "type": "string" },
        "lineKey": { "type": "string" },
        "qty": { "$ref": "#/$defs/numberOrText" },
        "height": { "type": "string" },
        "materialRate": { "$ref": "#/$defs/numberOrText" },
        "unitsPerDay": { "$ref": "#/$defs/numberOrText" },
        "laborDays": { "$ref": "#/$defs/numberOrText" },
        "direction": { "enum": ["add", "deduct"] },
        "amount": { "$ref": "#/$defs/numberOrText" }
      }
    },

    "rates": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subject", "unit"],
            "properties": {
              "subject": { "type": "string" },
              "code": { "type": "string" },
              "description": { "type": "string" },
              "scope": { "type": "string" },
              "unit": { "$ref": "#/$defs/unit" },
              "materialRate": { "type": ["number", "null"] },
              "unitsPerDay": { "type": ["number", "null"] },
              "roundTo": { "type": ["number", "null"] }
            }
          }
        },
        "labor": {
          "type": "object",
          "properties": {
            "hourlyRate": { "$ref": "#/$defs/numberOrText" },
            "bayAreaHourlyRate": { "$ref": "#/$defs/numberOrText" },
            "hoursPerDay": { "$ref": "#/$defs/numberOrText" },
            "dailyAdder": { "$ref": "#/$defs/numberOrText" },
            "dayRounding": { "enum": ["none", "half", "whole"] }
          }
        },
        "quantity": {
          "type": "object",
          "properties": {
            "source": { "enum": ["wasteSqFt", "sqFt", "calc"] },
            "roundTo": { "$ref": "#/$defs/numberOrText" },
            "wastePct": { "$ref": "#/$defs/numberOrText" }
          }
        },
        "subjectMap": { "type": "object", "additionalProperties": { "type": "string" } },
        "rateEntry": { "enum": ["manual", "catalog"] },
        "bayAreaCities": { "type": "array", "items": { "type": "string" } },
        "priceList": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "fileName": { "type": "string" },
                "sheetName": { "type": "string" },
                "importedAt": { "type": "string" },
                "itemCount": { "type": "integer" }
              }
            }
          ]
        }
      }
    }
  }
}
